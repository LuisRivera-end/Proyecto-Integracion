{
  "name": "print-client",
  "version": "1.0.0",
  "main": "print-service.js",
  "bin": "print-service.js",
  "scripts": {
    "build:exe": "pkg print-service.js --targets node18-win-x64 --output dist/print-service.exe",
    "build:linux": "pkg print-service.js --targets node18-linux-x64 --output dist/print-service"
  },
  "pkg": {
    "scripts": [
      "print-service.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "toastify-js": "^1.12.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
